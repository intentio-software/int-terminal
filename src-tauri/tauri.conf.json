{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intentio Terminal",
  "version": "1.1.0",
  "identifier": "com.intentio.terminal",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/int-terminal/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Intentio Terminal",
        "width": 1000,
        "height": 680,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/intentio-software/int-terminal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MDE3QzRFODU1RUI2NzYKUldSMnRsNkZUbndCaWRtWVJURlZaczNaS1VQdUdXVXordTNDbGZEdFBheFZSaUh3ekowK2lzUXUK"
    }
  }
}
